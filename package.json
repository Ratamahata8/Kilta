  },
  "devDependencies": {
    "@eslint/js": "9.39.0",
    "@playwright/test": "1.56.1",
    "@types/node": "24.10.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "9.39.0",
    "eslint-plugin-react-hooks": "7.0.1",
    "typescript": "5.9.3",
