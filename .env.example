# Only public Supabase project configuration. Never use secret/service_role keys.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Project Pages (/Kilta/) or a root/custom-domain deployment (/).
VITE_BASE_PATH=/Kilta/
# Explicit read-only demonstration. Pages defaults to demo without Supabase.
# A connected Supabase deployment sets this false and supplies the public URL/key.
VITE_DEMO_MODE=false
# Optional real integration/browser tests, never VITE_ variables:
TEST_SUPABASE_URL=
TEST_SUPABASE_PUBLISHABLE_KEY=
TEST_OWNER_EMAIL=
TEST_OWNER_PASSWORD=
TEST_OUTSIDER_EMAIL=
TEST_OUTSIDER_PASSWORD=
# Optional isolated PostgreSQL SQL-policy test target; never production data.
TEST_DATABASE_URL=
