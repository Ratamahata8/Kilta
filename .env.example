# Copy to .env; generate secrets locally, never commit .env.
DATABASE_URI=postgresql://kilta:CHANGE_ME@localhost:5432/kilta
POSTGRES_USER=kilta
POSTGRES_DB=kilta
POSTGRES_PASSWORD=
PAYLOAD_SECRET=
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
MEDIA_DIR=media
# Explicit opt-in only after legal content and production hosting are approved.
FORMS_ENABLED=false
INDEXING_ENABLED=false
# CLI only; unset after administrator creation.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
ADMIN_ROLE=developer
# Optional outgoing email. Without SMTP inquiries remain in the database.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
INQUIRY_EMAIL=
# Optional private S3-compatible bucket; do NOT expose bucket/CDN publicly.
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# VPS only
HOSTNAME=
# Optional Caddy Basic Auth; use caddy hash-password. Do not set unless desired.
DEMO_USER=
DEMO_PASSWORD_HASH=
